{
  "name": "@jmt-code/pdf-creator",
  "version": "0.1.0",
  "description": "Zero-dependency PDF 1.7 generator for the browser",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "pdf",
    "creator",
    "generator",
    "document"
  ],
  "author": "Jmt-code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jmt-code/pdfEditor.git",
    "directory": "packages/pdf-creator"
  },
  "bugs": {
    "url": "https://github.com/Jmt-code/pdfEditor/issues"
  },
  "homepage": "https://github.com/Jmt-code/pdfEditor/tree/main/packages/pdf-creator#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jsdom": "^25.0.1",
    "pdfjs-dist": "^4.10.38",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "sideEffects": false
}
